# .env.tp4 — gx1000 4-node cluster (switched 100G RoCE via SN2700, single rail)
# aligned to docs/tp4.md production profile; never commit real values

# ---- cluster ----
# Addressing: hostnames only, never hardcoded IPs (the fabric renumbers; the
# names don't). Name->IP lives in head's ~/.ssh/config (spark-<suffix> ->
# its NM-configured spark0 /32, switch-routed and stable). Fabric IPs are
# resolved at launch time from $FABRIC_IFACE, so re-cabling needs no edits
# here. If a worker is down the WORKER_IPS probe comes up short and start.sh
# aborts on the length check — loud, by design.
FABRIC_IFACE=enP7s7  # ring: HEAD/WORKER IPs resolve from the management LAN per docs/switchless-ring.md
WORKER_HOSTS="spark-0cdd spark-a470 spark-42ad"  # physical ring order = TP rank order
WORKER_IPS="$(for h in $WORKER_HOSTS; do ssh -o BatchMode=yes -o ConnectTimeout=10 "$h" \
  "ip -4 -o addr show dev $FABRIC_IFACE scope global" 2>/dev/null | awk 'NR==1{sub(/\/.*/,"",$4);print $4}' || true; done | tr '\n' ' ')"
HEAD_IP="$(ip -4 -o addr show dev $FABRIC_IFACE scope global | awk 'NR==1{sub(/\/.*/,"",$4);print $4}')"
WORKER_USER=gx1000
SSH_IDENTITY=$HOME/.ssh/id_ed25519
WORKER_DIR=/home/gx1000/dsv41-3x-spark

# ---- RoCE / NCCL ----
NCCL_SOCKET_IFNAME=enP7s7
GLOO_SOCKET_IFNAME=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN

# ---- model ----
MODEL_DIR=/home/gx1000/models/DeepSeek-V4.1-Flash-1017-UNCENSORED-FP8
HF_REPO=deepseek-ai/DeepSeek-V4.1-Flash-1017
HF_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
EXPECTED_SHARDS=48

# ---- NFS over ConnectX fabric ----
NFS_SHARE=1
NFS_VOLUME=dsv41-local-weights
NFS_SERVER_IPS="$HEAD_IP"
NFS_CLIENTS="10.240.0.0/16,10.250.0.0/24"

# ---- image ----
BUILD_DOCKERFILE=Dockerfile.canary-roce.local
IMAGE=dsv41-4x-spark:canary-roce
BASE_IMAGE=lmsysorg/sglang:dev-dsv41

# ---- parallelism ----
NNODES=4
TP_SIZE=4
EP_SIZE=1
DIST_PORT=20000
DSV41_TP_PAD=0

# ---- serving ----
OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=4
DSV41_CACHE_WAYS=16
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_STATS_SECONDS=60
CONTEXT_LENGTH=500000
MEM_FRACTION_STATIC=0.80
HEAD_MEM_FRACTION_STATIC=0.80
MAX_RUNNING_REQUESTS=16
CHUNKED_PREFILL_SIZE=4096
MAX_TOTAL_TOKENS=5000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json
ENGRAM_DIR=$HOME/dsv41-engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=0

# ---- kernels ----
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1 --enable-deepseek-v4-fp4-indexer --enable-cache-report --sleep-on-idle --enable-metrics"
DSV41_MXFP8_BACKEND=b12x
DSV41_SHARED_PAD_K=1
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
SGLANG_DSV41_REASONING_EFFORT=75
DSV41_MAX_NEW_TOKENS=32768
DSV41_LOOP_ABORT=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
SGLANG_RUST_BUILD_MODE=never

# ---- full production line (docs/tp4.md), single rail HCA ----
EXTRA_CONTAINER_ENV="RUSTUP_TOOLCHAIN=stable DSV41_INDEXER_CHUNKED=1 SGLANG_DSPARK_FOLDED_SAMPLING=2 SGLANG_ROCE_ALLREDUCE=1 SGLANG_ROCE_MAX_SIZE=262144 B12X_ROCE_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1 B12X_ROCE_CACHE_DIR=/state/b12x-roce B12X_COMPILE_CACHE_DIR=/state/b12x-compile SPARK_PREFILL_TP_SPLIT=1 SPARK_PREFILL_TP_MIN_CONTEXT=32768 SPARK_PREFILL_TP_MIN_ROWS=1024 SGLANG_RUST_BUILD_MODE=never DSV41_FAST_LOAD=1 DSV41_FAST_LOAD_EP_SIZE=1 DSV41_FAST_LOAD_TP_SLICE=auto DSV41_FAST_LOAD_N_EXPERTS=384 DSV41_FAST_LOAD_INFLIGHT_GB=6 DSV41_ENGRAM_PREFETCH=1 DSV41_SHARED_PAD_K=1 DSV41_WO_A_W8=1 DSV41_DRAFT_TAU=0.7 DSV41_DRAFT_HEAD_FP8=1 DSV41_DRAFT_HEAD_FP8_IMPL=tp4 DSV41_BLOCK_VERIFY=1 DSV41_FOLDED_FENCE=1 DSV41_VERIFY_CAP=conf:0.1 DSV41_AUTOTUNE_KEEP=1 DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1 DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_MAIN_PROJ_SPLIT=1 DSV41_ROCE_GATHER=262144 DSV41_ROUTER_LIVE=1 DSV41_MOE_B12X_NEXT=1 DSV41_MOE_B12X_NEXT_DETERMINISTIC=1 DSV41_HC_FUSED=1 DSV41_PREFILL_SP=1 DSV41_PREFILL_SP_FP8=1 DSV41_L2_PREFETCH=1 DSV41_ROCE_RING=1 B12X_ROCE_PEER_HCA_MAPS=1=0/2,2=0/3,3=1/3;0=1/3,2=0/2,3=0/3;0=1/2,1=1/3,3=0/2;0=0/2,1=1/2,2=1/3 B12X_ROCE_TWO_WAVE_THRESHOLD_BYTES=0 NCCL_IB_MERGE_NICS=0 NCCL_IB_SUBNET_AWARE_ROUTING=1 NCCL_CROSS_NIC=1 NCCL_PROTO=LL,LL128,Simple NCCL_SKIP_TREE_CONNECT=1 NCCL_CUMEM_ENABLE=0 NCCL_IGNORE_CPU_AFFINITY=1 NCCL_IB_GID_INDEX=3"

# ─── switchless ring (appended by start-tp4-switchless.sh) ────────────────────
NCCL_SWITCHLESS_RING_ONLY=1
NCCL_HOST_DIR=$HOME/nccl-2.30.7
NCCL_ALGO=Ring
NCCL_IB_SUBNET_PREFIX_LEN=24
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_P2P_LEVEL=SYS
DSV41_SERIAL_WEIGHT_LOAD=1
NFS_SHARE=0

# 2026-11-06 measured tuning: enable both NCCL PCI domains.
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,ENV,NET
EXTRA_CONTAINER_ENV="$EXTRA_CONTAINER_ENV NCCL_IB_EXTENDED_IPV4_GIDS=1 NCCL_IB_PRESERVE_PCI_DOMAIN=1 NCCL_IB_ROUTE_DIAGNOSTICS=1 NCCL_IB_QPS_PER_CONNECTION=1 NCCL_DEBUG_SUBSYS=INIT,ENV,NET"
